# Copy to server as /opt/attendance/attendance.env (chmod 600).
# systemd: EnvironmentFile=/opt/attendance/attendance.env
# Lines are KEY=value — no "export", no quotes needed unless value has spaces.

# --- Required: MySQL profile ---
SPRING_PROFILES_ACTIVE=mysql

# --- Database: use ONE style (A or B) ---

# (A) Full JDBC URL (replace HOST, DATABASE, USER, PASSWORD; set useSSL=true if provider requires TLS)
# MYSQL_JDBC_URL=jdbc:mysql://HOST:3306/DATABASE?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
# MYSQL_USER=
# MYSQL_PASSWORD=

# (B) Split variables (matches application-mysql.yml when MYSQL_JDBC_URL is unset)
MYSQL_HOST=YOUR_MYSQL_HOST
MYSQL_PORT=3306
MYSQL_DATABASE=YOUR_DATABASE_NAME
MYSQL_USER=YOUR_MYSQL_USER
MYSQL_PASSWORD=YOUR_MYSQL_PASSWORD
MYSQL_USE_SSL=false

# First deploy: let Hibernate create/update tables. Later consider: MYSQL_DDL_AUTO=validate
MYSQL_DDL_AUTO=update

# --- Required: JWT (min ~32 chars; generate a random secret for production) ---
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# --- Server port (default 8080; nginx proxies here) ---
PORT=8080

# --- File uploads (persistent folder on the VPS) ---
UPLOAD_DIR=/opt/attendance/uploads

# --- If the SPA is on another HTTPS origin (comma-separated, no trailing slash on origins) ---
# CORS_ALLOWED_ORIGINS=https://portal.clientdomain.com

# --- Optional: absolute API base for file URLs in JSON ---
# API_PUBLIC_BASE_URL=https://api.clientdomain.com

# --- Optional: public customer feedback rate limit ---
# PUBLIC_FEEDBACK_RATE_LIMIT_PER_MINUTE=120
